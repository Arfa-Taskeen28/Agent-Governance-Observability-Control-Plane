# Copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database (multi-tenant)
DATABASE_URL=postgresql+psycopg2://agent:agent@localhost:5432/agentdb

# Async workers
REDIS_URL=redis://localhost:6379/0

# LLM (optional; only used to narrate compliance summaries).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Alerting. If set, threshold-breach alerts are POSTed to this Slack webhook.
SLACK_WEBHOOK_URL=

# Auth
JWT_SECRET=dev-only-change-me
